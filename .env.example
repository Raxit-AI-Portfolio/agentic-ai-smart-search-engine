# --- docker-compose.yml (shared Postgres container, see project-notes/DbSetp.md) ---
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser

# --- Auth API (integration/auth/api) — the only service that talks to
# membershipdb or holds the JWT secret. Issues/revokes tokens and caches each
# token's identity in Redis on login; /auth/verify checks that cache, not the
# DB. Every other API calls it over HTTP instead of verifying JWTs itself. ---
MEMBERSHIP_DB_URL=postgresql://auth_service:CHANGE_ME_auth_service@localhost:5432/membershipdb
JWT_SECRET_KEY=CHANGE_ME_dev_only_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Shared cache module (integration/shared/cache) — required by the Auth
# API (to store/check auth:{jti} status) and the Shared API/caching-worker. ---
REDIS_URL=redis://localhost:6379/0

# --- Auth API base URL — used by the Shared API, Customer API, and Operations
# API to verify a caller's JWT via POST /auth/verify instead of doing it
# in-process (see each service's auth_client.py). ---
AUTH_API_BASE_URL=http://localhost:8003

# --- Caching worker (integration/caching_worker) ---
# Loads lookup data into Redis at startup, reusing the existing read-only
# "worker" DB roles/URLs defined below for the Customer and Operations APIs.

# --- Customer API (integration/customer/api) ---
# One Postgres connection string per DB role, so the API can connect as the
# role matching the caller's JWT (see integration/customer/db/customerdb_schema.sql).
CUSTOMERDB_CUSTOMER_URL=postgresql://customer:CHANGE_ME_customer@localhost:5432/customerdb
CUSTOMERDB_WORKER_URL=postgresql://worker:CHANGE_ME_worker@localhost:5432/customerdb
CUSTOMERDB_MANAGER_URL=postgresql://manager:CHANGE_ME_manager@localhost:5432/customerdb

# --- Operations API (integration/operation/api) ---
# Same idea, against operationsdb (see integration/operation/db/operationsdb_schema.sql).
OPERATIONSDB_CUSTOMER_URL=postgresql://customer:CHANGE_ME_customer@localhost:5432/operationsdb
OPERATIONSDB_WORKER_URL=postgresql://worker:CHANGE_ME_worker@localhost:5432/operationsdb
OPERATIONSDB_MANAGER_URL=postgresql://manager:CHANGE_ME_manager@localhost:5432/operationsdb

# GetByPaymentType needs PaymentMethod.PaymentType, which lives in CustomerDb —
# the Operations API resolves it by calling the Customer API directly.
CUSTOMER_API_BASE_URL=http://localhost:8000

# --- API MCP server (agentic_core/mcp_servers/api_server) — federates calls to
# both APIs, forwarding the caller's JWT rather than authenticating itself. ---
OPERATIONS_API_BASE_URL=http://localhost:8001

# --- RAG ingestion + retrieval (rag_ingestion/, agentic_core/services/rag_service.py) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=efsse_docs

# --- Planning node (agentic_core/nodes/planning_node.py) — query decomposition LLM ---
GOOGLE_API_KEY=CHANGE_ME_gemini_api_key

# --- Optional: LangSmith tracing (auto-instruments every langchain-core call,
# including ChatGoogleGenerativeAI, via these env vars — no code changes).
# Leave LANGCHAIN_TRACING_V2 unset/false to disable. ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=CHANGE_ME_langsmith_api_key
LANGCHAIN_PROJECT=efsse
